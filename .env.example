# TUI Agent 运行环境配置
# 复制此文件为 .env 并填入实际值: cp .env.example .env

# ---------- 必须配置 ----------

# Provider: openai_compat（默认）或 anthropic
TUI_AGENT_PROVIDER=openai_compat

# OpenAI 兼容 API Key（provider=openai_compat）
# 也支持 OPENAI_API_KEY
TUI_AGENT_API_KEY=your-api-key-here

# Anthropic API Key（provider=anthropic 时使用；也可只用 ANTHROPIC_API_KEY）
# ANTHROPIC_API_KEY=your-anthropic-key-here

# ---------- 模型配置（可选，覆盖 YAML 配置与内置默认值） ----------

# 当前使用的模型
TUI_AGENT_MODEL=gpt-4o-mini
# Anthropic 示例: TUI_AGENT_MODEL=claude-sonnet-4-5

# 可通过 /model 切换的模型列表（方括号内每行一个）
TUI_AGENT_MODELS=[
gpt-4o-mini
gpt-4o
claude-sonnet-4-5
deepseek-chat
]

# API 地址
# OpenAI 兼容默认: https://api.openai.com/v1
# Anthropic 默认: https://api.anthropic.com（provider=anthropic 时自动纠正 openai.com）
TUI_AGENT_API_BASE=https://api.openai.com/v1

# 请求超时时间（秒）
TUI_AGENT_TIMEOUT=120

# 单次任务最大推理轮次（新任务重置，权限确认不重置）
TUI_AGENT_MAX_TURNS=50

# 网络错误最大重试次数
TUI_AGENT_MAX_RETRIES=3

# 请求上下文 token 预算（含工具定义与回复预留；接近预算时摘要早期消息）
TUI_AGENT_CONTEXT_MAX_TOKENS=32000
