# TUI Agent 运行环境配置
# 复制此文件为 .env 并填入实际值: cp .env.example .env

# ---------- 必须配置 ----------

# OpenAI 兼容 API Key（必填；也支持 OPENAI_API_KEY）
TUI_AGENT_API_KEY=your-api-key-here

# ---------- 模型配置（可选，覆盖 config/default.yaml） ----------

# 当前使用的模型
TUI_AGENT_MODEL=gpt-4o-mini

# 可通过 /model 切换的模型列表（方括号内每行一个）
TUI_AGENT_MODELS=[
gpt-4o-mini
gpt-4o
deepseek-chat
]

# API 地址（任意 OpenAI 兼容端点）
TUI_AGENT_API_BASE=https://api.openai.com/v1

# 请求超时时间（秒）
TUI_AGENT_TIMEOUT=120

# 最大推理轮次
TUI_AGENT_MAX_TURNS=50

# 网络错误最大重试次数
TUI_AGENT_MAX_RETRIES=3

# 上下文压缩 token 阈值（超过此值自动压缩早期消息）
TUI_AGENT_CONTEXT_MAX_TOKENS=32000
